# ─────────────────────────────────────────────────────────────────────────────
# Server-Konfiguration. Kopiere nach ".env" und fülle die Werte aus.
# Es gibt KEINE Secrets "von außen" — alles legt ihr selbst fest.
# Geheimnisse erzeugen:  openssl rand -hex 32
# NUR diese Beispiel-Datei wird committet, niemals die echte .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── PFLICHT ──────────────────────────────────────────────────────────────────
# Datenbank
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=BITTE_STARKES_PASSWORT_SETZEN
POSTGRES_DB=cockpit

# Session-Signatur der App   (openssl rand -hex 32)
AUTH_SECRET=BITTE_32_BYTE_HEX_SETZEN

# n8n-Verschlüsselung        (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=BITTE_32_BYTE_HEX_SETZEN

# Rückkanal für Automationen (openssl rand -hex 32)
# n8n-Workflows melden Läufe an POST /api/automations/log; dieser Endpoint ist
# ohne Login erreichbar und MUSS auf dem Server mit diesem Secret geschützt sein.
AUTOMATION_INGEST_SECRET=BITTE_32_BYTE_HEX_SETZEN

# ── HOST-PORTS (optional, Defaults in Klammern) ──────────────────────────────
WEB_PORT=4000        # Host-Port der Web-App  (Default 3000)
N8N_PORT=5679        # Host-Port von n8n, nur 127.0.0.1  (Default 5678)

# ── KI-ASSISTENT (OPTIONAL) ──────────────────────────────────────────────────
# Ohne Schlüssel läuft das Dashboard normal; nur Chat-Assistent + Drive-Import
# sind dann deaktiviert.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── GOOGLE DRIVE (OPTIONAL) ──────────────────────────────────────────────────
# Leer lassen = /drive zeigt "nicht eingerichtet", Rest der App unberührt.
# Wenn genutzt: Client-Typ "Webanwendung", Redirect-URI exakt wie unten.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hkgrowth.tail0398a8.ts.net:8443/api/google/callback

# ── ZENTRALE (siehe ZENTRALE.md) ─────────────────────────────────────────────
# Öffentliche Adresse des Cockpits, z. B. https://cockpit.hk-growthoperator.de
COCKPIT_URL=
# Adresse der n8n-Oberfläche (Link in der Seitenleiste + Statusanzeige)
N8N_PUBLIC_URL=
# Schlüssel für gespeicherte Geheimnisse   (openssl rand -hex 32)
# Einmal setzen und NICHT mehr ändern — sonst sind gespeicherte Passwörter unlesbar.
ZENTRALE_SECRET_KEY=
# Schützt den Mail-Takt POST /api/zentrale/takt   (openssl rand -hex 32)
ZENTRALE_TAKT_SECRET=
# GitHub, nur lesend (Fine-grained Token: Contents, Metadata, Pull requests, Actions).
# Alternativ in der App unter Einstellungen → GitHub hinterlegen.
GITHUB_TOKEN=
# Optionales Versand-Postfach aus der Umgebung (all-inkl: Port 465, SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=HK Growth Operator
